{
  "manifest_version": 3,
  "name": "Kari — pitch & speed for music",
  "short_name": "Kari",
  "version": "0.3.0",
  "description": "Key and speed of music on youtube.com and soundcloud.com. Slide for speed, tap for pitch. By YGG HOMME, powered by Cantum.",
  "author": {
    "email": "info@cantum.io"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://www.youtube.com/*"
  ],
  "optional_host_permissions": [
    "https://soundcloud.com/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "worklet.js",
        "rubberband.wasm"
      ],
      "matches": [
        "*://www.youtube.com/*",
        "https://soundcloud.com/*"
      ]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Kari settings",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "pitch-up": {
      "suggested_key": {
        "default": "Alt+Up"
      },
      "description": "Pitch up one semitone"
    },
    "pitch-down": {
      "suggested_key": {
        "default": "Alt+Down"
      },
      "description": "Pitch down one semitone"
    },
    "tempo-up": {
      "suggested_key": {
        "default": "Alt+Right"
      },
      "description": "Speed up 1%"
    },
    "tempo-down": {
      "suggested_key": {
        "default": "Alt+Left"
      },
      "description": "Slow down 1%"
    }
  }
}
